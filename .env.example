# Copy to .env.local (never commit it) and fill in. On Vercel: Project Settings -> Environment Variables.

# Supabase (Dashboard -> Project Settings -> API). Sign-in uses Supabase Auth's Google provider.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The same Google OAuth client configured in Supabase -> Authentication -> Providers -> Google.
# The server uses it to refresh Gmail access tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI API key for AI features (write with AI, reply drafts, summaries, auto labels). Optional: without it AI is off.
OPENAI_API_KEY=
# Model used for every AI call. Must support Chat Completions structured outputs (json_schema).
OPENAI_MODEL=gpt-5-mini
# Reasoning models only (gpt-5 family, o-series): none|minimal|low|medium|high, or off. Defaults to low.
OPENAI_REASONING_EFFORT=

# Public URL of the app, no trailing slash. Optional locally; set it in production (e.g. https://zerolatency.vercel.app).
APP_URL=

# Set to 1 to run with a built-in fictional mailbox instead of Google (no credentials needed).
ZL_DEMO=
